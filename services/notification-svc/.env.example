# Local development only. In the cluster these come from ConfigMaps/Secrets.
PORT=8080
LOG_LEVEL=info
NODE_ENV=development
RABBITMQ_URL=amqp://notify:CHANGE_ME@rabbitmq.data.svc.cluster.local:5672
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD_PATH=/etc/secrets/smtp/password
MAIL_FROM=no-reply@dhaga.example
