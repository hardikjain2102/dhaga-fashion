# Local development only. In the cluster these come from ConfigMaps/Secrets.
PORT=8080
LOG_LEVEL=info
NODE_ENV=development
REDIS_URL=redis://redis.data.svc.cluster.local:6379
JWT_PUBLIC_KEY_PATH=/etc/secrets/jwt/public.pem
CATALOG_SERVICE_URL=http://catalog-svc.services.svc.cluster.local
CART_TTL_SECONDS=1800
