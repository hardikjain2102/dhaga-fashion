# Local development only. In the cluster these come from ConfigMaps/Secrets.
PORT=8080
LOG_LEVEL=info
NODE_ENV=development
DATABASE_URL=postgres://payment_user:CHANGE_ME@postgres.data.svc.cluster.local:5432/paymentdb
RABBITMQ_URL=amqp://payment:CHANGE_ME@rabbitmq.data.svc.cluster.local:5672
JWT_PUBLIC_KEY_PATH=/etc/secrets/jwt/public.pem
RAZORPAY_KEY_ID_PATH=/etc/secrets/razorpay/key_id
RAZORPAY_KEY_SECRET_PATH=/etc/secrets/razorpay/key_secret
RAZORPAY_WEBHOOK_SECRET_PATH=/etc/secrets/razorpay/webhook_secret
