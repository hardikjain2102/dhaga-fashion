# Local development only. In the cluster these come from ConfigMaps/Secrets.
# Any secret NAME can be given directly, or as NAME_PATH pointing to a file (Kubernetes Secret mounted as a file).
PORT=8080
LOG_LEVEL=info
NODE_ENV=development
DATABASE_URL=postgres://auth_user:CHANGE_ME@postgres.data.svc.cluster.local:5432/authdb
JWT_PRIVATE_KEY_PATH=/etc/secrets/jwt/private.pem
JWT_PUBLIC_KEY_PATH=/etc/secrets/jwt/public.pem
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_SECURE=true
TRUST_PROXY=1
RATE_LIMIT_MAX=20
# Only for the create-admin script / bootstrap Job:
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD_PATH=/etc/secrets/admin/password
