# Local development only. In the cluster these come from ConfigMaps/Secrets.
PORT=8080
LOG_LEVEL=info
NODE_ENV=development
DATABASE_URL=postgres://order_user:CHANGE_ME@postgres.data.svc.cluster.local:5432/orderdb
RABBITMQ_URL=amqp://order:CHANGE_ME@rabbitmq.data.svc.cluster.local:5672
JWT_PUBLIC_KEY_PATH=/etc/secrets/jwt/public.pem
CART_SERVICE_URL=http://cart-svc.services.svc.cluster.local
CATALOG_SERVICE_URL=http://catalog-svc.services.svc.cluster.local
PAYMENT_SERVICE_URL=http://payment-svc.payments.svc.cluster.local
