# Local development only. In the cluster these come from ConfigMaps/Secrets.
# Any secret NAME can be given directly, or as NAME_PATH pointing to a file (Kubernetes Secret mounted as a file).
PORT=8080
LOG_LEVEL=info
NODE_ENV=development
DATABASE_URL=postgres://catalog_user:CHANGE_ME@postgres.data.svc.cluster.local:5432/catalogdb
JWT_PUBLIC_KEY_PATH=/etc/secrets/jwt/public.pem
AUTH_SERVICE_URL=http://auth-svc.services.svc.cluster.local
INTERNAL_API_SECRET_PATH=/etc/secrets/internal/secret
